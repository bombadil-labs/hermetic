{
  "name": "@bombadil/hermetic",
  "version": "0.2.0",
  "description": "Lint rule for hermetic functions: functions that touch the world only through their arguments and `this`.",
  "license": "MIT",
  "homepage": "https://github.com/bombadil-labs/hermetic#readme",
  "bugs": {
    "url": "https://github.com/bombadil-labs/hermetic/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build",
    "corpus": "node scripts/corpus.mjs",
    "site": "node scripts/site.mjs"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript-eslint",
    "hermetic",
    "closure",
    "free-variables",
    "object-capabilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bombadil-labs/hermetic.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.1"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "eslint": "^10.11.0",
    "marked": "^18.0.14",
    "shiki": "^4.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
