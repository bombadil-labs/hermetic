{
  "name": "hermetic-workspace",
  "private": true,
  "description": "Hermetic functions: the @bombadil/hermetic runtime package and the @bombadil/eslint-plugin-hermetic ESLint plugin.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/hermetic",
    "packages/eslint-plugin-hermetic"
  ],
  "scripts": {
    "build": "npm run build -w @bombadil/hermetic && npm run build -w @bombadil/eslint-plugin-hermetic",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node --conditions=@bombadil/source node_modules/eslint/bin/eslint.js .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "corpus": "node --conditions=@bombadil/source scripts/corpus.mjs",
    "site": "node scripts/site.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "eslint": "^10.11.0",
    "marked": "^18.0.14",
    "shiki": "^4.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
