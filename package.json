{
  "name": "eslint-plugin-isolated",
  "version": "0.1.0",
  "description": "Lint rule for isolated functions: functions that touch the world only through their arguments and `this`.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "typescript-eslint",
    "closure",
    "free-variables",
    "object-capabilities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bombadil-labs/ts-isolated.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.1"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
