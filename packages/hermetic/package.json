{
  "name": "@bombadil/hermetic",
  "version": "0.3.0",
  "description": "Hermetic functions at runtime: check that a function reads nothing but its inputs, and run it confined.",
  "license": "MIT",
  "homepage": "https://bombadil-labs.github.io/hermetic/",
  "bugs": {
    "url": "https://github.com/bombadil-labs/hermetic/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bombadil-labs/hermetic.git",
    "directory": "packages/hermetic"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@bombadil/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inject": {
      "@bombadil/source": "./src/inject.ts",
      "types": "./dist/inject.d.ts",
      "default": "./dist/inject.js"
    },
    "./doctest": {
      "@bombadil/source": "./src/doctest.ts",
      "types": "./dist/doctest.d.ts",
      "default": "./dist/doctest.js"
    },
    "./record": {
      "@bombadil/source": "./src/record.ts",
      "types": "./dist/record.d.ts",
      "default": "./dist/record.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hermetic",
    "closure",
    "free-variables",
    "object-capabilities",
    "hardened-javascript",
    "ses",
    "sandbox"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  },
  "devDependencies": {
    "ses": "^2.3.0"
  }
}
