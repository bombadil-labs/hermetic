{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "customConditions": [
      "@bombadil/source"
    ]
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/eslint-plugin-hermetic/examples",
    "vitest.config.ts"
  ],
  "exclude": [
    "packages/eslint-plugin-hermetic/tests/fixtures"
  ]
}
